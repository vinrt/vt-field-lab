# Local environment configuration
# Keep examples safe and commit-ready, but never commit real environment files.
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example
.envrc
.envrc.*
!.envrc.example
.npmrc
!.npmrc.example
*.local

# Cloudflare Wrangler local state
.wrangler/

